# Clearlook. A service key with only "Ask questions (query)" (Settings › API keys), for webhook and channel-watch runs.
CLEARLOOK_API_KEY=
# The project to investigate when a request names none (slug, name or id). Try "demo".
CLEARLOOK_PROJECT=
# Your own Clearlook server, if you run one.
CLEARLOOK_URL=https://app.clearlook.dev
# Used only without CLEARLOOK_API_KEY: vercel connect create https://app.clearlook.dev/mcp --connection-method mcp --name sre
CLEARLOOK_CONNECTOR=clearlook/sre

# Connector UIDs. Defaults match `vercel connect create <type> --name sre`.
SLACK_CONNECTOR=slack/sre
GITHUB_CONNECTOR=github/sre
SRE_VERCEL_CONNECTOR=vercel/sre

# Shared secret for automated investigations. Required for POST /v1/investigate.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
